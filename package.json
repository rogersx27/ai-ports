{
  "name": "@rogersx27/ai-ports",
  "version": "0.1.0",
  "description": "Capa de IA agnóstica de proveedor: puertos IAiAssistant/IAiEvaluator, adaptadores (Gemini, Anthropic, OpenAI, Vercel AI Gateway, Jev) y utilidades de timeout y caché.",
  "license": "MIT",
  "type": "module",
  "engines": {
    "node": ">=22"
  },
  "files": [
    "dist"
  ],
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    },
    "./gemini": {
      "types": "./dist/adapters/GeminiAiAssistant.d.ts",
      "import": "./dist/adapters/GeminiAiAssistant.js"
    },
    "./anthropic": {
      "types": "./dist/adapters/AnthropicAiAssistant.d.ts",
      "import": "./dist/adapters/AnthropicAiAssistant.js"
    },
    "./openai": {
      "types": "./dist/adapters/OpenAiAssistant.d.ts",
      "import": "./dist/adapters/OpenAiAssistant.js"
    },
    "./gateway": {
      "types": "./dist/adapters/gateway.d.ts",
      "import": "./dist/adapters/gateway.js"
    }
  },
  "scripts": {
    "build": "tsc -p tsconfig.build.json",
    "typecheck": "tsc --noEmit",
    "test": "node --test tests/*.test.ts",
    "prepare": "tsc -p tsconfig.build.json"
  },
  "peerDependencies": {
    "@anthropic-ai/sdk": ">=0.127.0",
    "@google/genai": ">=2.23.0",
    "ai": "^7.0.107",
    "openai": ">=7.20.0"
  },
  "peerDependenciesMeta": {
    "@anthropic-ai/sdk": {
      "optional": true
    },
    "@google/genai": {
      "optional": true
    },
    "ai": {
      "optional": true
    },
    "openai": {
      "optional": true
    }
  },
  "devDependencies": {
    "@anthropic-ai/sdk": "^0.127.0",
    "@google/genai": "^2.23.0",
    "@types/node": "^22.20.4",
    "ai": "^7.0.107",
    "openai": "^7.20.0",
    "typescript": "^5.9.3"
  },
  "packageManager": "pnpm@12.3.4"
}
